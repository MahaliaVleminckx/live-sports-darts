@inherits LayoutComponentBase

<div class="layout">

    <div class="topbar">

        <button class="hamburger" @onclick="ToggleMenu">
            ☰
        </button>

        <div class="title">
            🎯 LiveSports
        </div>

    </div>

    <div class="body">

        <div class="sidebar @(collapsed ? "hidden" : "")">
            <NavMenu />
        </div>

        <div class="content">
            @Body
        </div>

    </div>

</div>

@code {
    private bool collapsed = false;

    private void ToggleMenu()
    {
        collapsed = !collapsed;
    }
}