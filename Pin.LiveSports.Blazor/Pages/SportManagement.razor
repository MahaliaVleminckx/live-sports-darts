@page "/sportmanagement"

@using Pin.LiveSports.Core.Interfaces
@using Pin.LiveSports.Core.Models
@inject ICountryService CountryService
@inject IPlayerService PlayerService

<div class="management-grid">

    <!-- COUNTRIES -->
    <div class="panel">

        <h4>🌍 Countries</h4>

        <ul class="list">
            @foreach (var country in countries)
            {
                <li class="row">
                    <span>@country.Name</span>

                    <div class="actions">
                        <button class="btn btn-warning btn-sm"
                                @onclick="() => StartEditCountry(country)">
                            Edit
                        </button>

                        <button class="btn btn-danger btn-sm"
                                @onclick="() => DeleteCountry(country.Id)">
                            Delete
                        </button>
                    </div>
                </li>
            }
        </ul>

        @if (!string.IsNullOrWhiteSpace(countryError))
        {
            <div class="validation-error">@countryError</div>
        }

        @if (editingCountryId == 0)
        {
            <div class="form-box">

                <input class="input"
                       @bind="newCountryName"
                       placeholder="New country" />

                <button class="btn btn-success btn-sm"
                        @onclick="AddCountry">
                    Add Country
                </button>

            </div>
        }
        else
        {
            <div class="edit-box">

                <h5>Edit Country</h5>

                <input class="input"
                       @bind="editCountryName" />

                <div class="btn-row">
                    <button class="btn btn-success btn-sm"
                            @onclick="UpdateCountry">
                        Save
                    </button>

                    <button class="btn btn-secondary btn-sm"
                            @onclick="CancelCountryEdit">
                        Cancel
                    </button>
                </div>

            </div>
        }

    </div>

    <!-- PLAYERS -->
    <div class="panel">

        <h4>🎯 Players</h4>

        <ul class="list">
            @foreach (var player in players)
            {
                <li class="row">
                    <span>
                        <b>@player.Nickname</b> (@player.Name)
                    </span>

                    <div class="actions">
                        <button class="btn btn-warning btn-sm"
                                @onclick="() => StartEditPlayer(player)">
                            Edit
                        </button>

                        <button class="btn btn-danger btn-sm"
                                @onclick="() => DeletePlayer(player.Id)">
                            Delete
                        </button>
                    </div>
                </li>
            }
        </ul>

        @if (!string.IsNullOrWhiteSpace(playerError))
        {
            <div class="validation-error">@playerError</div>
        }

        @if (editingPlayerId == 0)
        {
            <div class="form-box">

                <input class="input"
                       @bind="newPlayerName"
                       placeholder="Name" />

                <input class="input"
                       @bind="newPlayerNickname"
                       placeholder="Nickname" />

                <select class="input"
                        @bind="selectedCountryId">
                    <option value="0">Select country</option>
                    @foreach (var c in countries)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>

                <button class="btn btn-primary"
                        @onclick="AddPlayer">
                    Add Player
                </button>

            </div>
        }
        else
        {
            <div class="edit-box">

                <h5>Edit Player</h5>

                <input class="input"
                       @bind="editPlayerName" />

                <input class="input"
                       @bind="editPlayerNickname" />

                <select class="input"
                        @bind="editCountryId">
                    @foreach (var c in countries)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>

                <div class="btn-row">
                    <button class="btn btn-success btn-sm"
                            @onclick="UpdatePlayer">
                        Save
                    </button>

                    <button class="btn btn-secondary btn-sm"
                            @onclick="CancelEdit">
                        Cancel
                    </button>
                </div>

            </div>
        }

    </div>

</div>

@code {

    private List<Country> countries = new();
    private List<Player> players = new();

    private string newCountryName = "";
    private string newPlayerName = "";
    private string newPlayerNickname = "";
    private int selectedCountryId;

    private int editingPlayerId = 0;
    private string editPlayerName = "";
    private string editPlayerNickname = "";
    private int editCountryId;

    private int editingCountryId = 0;
    private string editCountryName = "";

    private string? countryError;
    private string? playerError;

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        countries = CountryService.GetAll();
        players = PlayerService.GetAll();
    }

    // ---------------- COUNTRIES ----------------

    private void AddCountry()
    {
        countryError = null;

        if (string.IsNullOrWhiteSpace(newCountryName))
        {
            countryError = "Country name is required.";
            return;
        }

        if (newCountryName.Length < 2)
        {
            countryError = "Country name must be at least 2 characters.";
            return;
        }

        if (countries.Any(c => c.Name.Equals(newCountryName, StringComparison.OrdinalIgnoreCase)))
        {
            countryError = "Country already exists.";
            return;
        }

        CountryService.Add(new Country { Name = newCountryName });

        newCountryName = "";
        LoadData();
    }

    private void DeleteCountry(int id)
    {
        CountryService.Delete(id);
        LoadData();
    }

    private void StartEditCountry(Country country)
    {
        editingCountryId = country.Id;
        editCountryName = country.Name;
    }

    private void UpdateCountry()
    {
        countryError = null;

        if (editingCountryId == 0 || string.IsNullOrWhiteSpace(editCountryName))
            return;

        if (editCountryName.Length < 2)
        {
            countryError = "Country name too short.";
            return;
        }

        CountryService.Update(new Country
        {
            Id = editingCountryId,
            Name = editCountryName
        });

        CancelCountryEdit();
        LoadData();
    }

    private void CancelCountryEdit()
    {
        editingCountryId = 0;
        editCountryName = "";
    }

    // ---------------- PLAYERS ----------------

    private void AddPlayer()
    {
        playerError = null;

        if (string.IsNullOrWhiteSpace(newPlayerName))
        {
            playerError = "Player name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newPlayerNickname))
        {
            playerError = "Nickname is required.";
            return;
        }

        if (newPlayerName.Length < 2 || newPlayerNickname.Length < 2)
        {
            playerError = "Name and nickname must be at least 2 characters.";
            return;
        }

        if (selectedCountryId == 0)
        {
            playerError = "Country is required.";
            return;
        }

        if (players.Any(p =>
            p.Name.Equals(newPlayerName, StringComparison.OrdinalIgnoreCase) &&
            p.Nickname.Equals(newPlayerNickname, StringComparison.OrdinalIgnoreCase)))
        {
            playerError = "Player already exists.";
            return;
        }

        PlayerService.Add(new Player
        {
            Name = newPlayerName,
            Nickname = newPlayerNickname,
            CountryId = selectedCountryId
        });

        newPlayerName = "";
        newPlayerNickname = "";
        selectedCountryId = 0;

        LoadData();
    }

    private void DeletePlayer(int id)
    {
        PlayerService.Delete(id);
        LoadData();
    }

    private void StartEditPlayer(Player player)
    {
        editingPlayerId = player.Id;
        editPlayerName = player.Name;
        editPlayerNickname = player.Nickname;
        editCountryId = player.CountryId;
    }

    private void UpdatePlayer()
    {
        playerError = null;

        if (editingPlayerId == 0 ||
            string.IsNullOrWhiteSpace(editPlayerName) ||
            string.IsNullOrWhiteSpace(editPlayerNickname) ||
            editCountryId == 0)
            return;

        PlayerService.Update(new Player
        {
            Id = editingPlayerId,
            Name = editPlayerName,
            Nickname = editPlayerNickname,
            CountryId = editCountryId
        });

        CancelEdit();
        LoadData();
    }

    private void CancelEdit()
    {
        editingPlayerId = 0;
        editPlayerName = "";
        editPlayerNickname = "";
        editCountryId = 0;
    }
}