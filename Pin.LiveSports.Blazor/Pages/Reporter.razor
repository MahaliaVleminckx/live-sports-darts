@page "/reporter"

@inject DartGameService Game
@using Pin.LiveSports.Core.Enums
@using Pin.LiveSports.Core.Models
@using Pin.LiveSports.Blazor.Services

<h2 class="page-title">🎯 Reporter Control Room</h2>

@if (!Game.CanRenderMatch)
{
    <div class="empty-state">
        No active match
    </div>
}
else
{
    <div class="reporter-grid">

        <div class="panel">

            <h3>➕ New Event</h3>

            <label>Player</label>
            <select class="input" @bind="selectedPlayerId">
                <option value="@Game.CurrentMatch.Player1.Id">
                    @Game.CurrentMatch.Player1.Nickname
                </option>
                <option value="@Game.CurrentMatch.Player2.Id">
                    @Game.CurrentMatch.Player2.Nickname
                </option>
            </select>

            <label>Type</label>
            <select class="input" @bind="selectedType">
                @foreach (var t in Enum.GetValues<EventType>())
                {
                    <option value="@t">@t</option>
                }
            </select>

            <label>
                Score @(selectedType == EventType.NoScore ? "(disabled)" : "")
            </label>

            <input class="input"
                   type="number"
                   @bind="score"
                   disabled="@(selectedType == EventType.NoScore)" />

            <label>Message</label>
            <input class="input" @bind="message" />

            @if (!string.IsNullOrWhiteSpace(validationMessage))
            {
                <div class="validation-error">
                    @validationMessage
                </div>
            }

            <button class="btn btn-success" @onclick="AddEvent">
                Add Event
            </button>

        </div>

        <div class="panel">

            <div class="match-header">

                <div class="set-leg">
                    Set <b>@Game.CurrentMatch.CurrentSet</b>
                    • Leg <b>@Game.CurrentMatch.CurrentLeg</b>
                </div>

                <div class="scoreboard">

                    <div class="player">
                        <div class="name">@Game.CurrentMatch.Player1.Nickname</div>
                        <div class="score">@Game.CurrentMatch.Player1Score</div>
                        <div class="meta">
                            Sets: @Game.CurrentMatch.Player1Sets |
                            Legs: @Game.CurrentMatch.Player1Legs
                        </div>
                    </div>

                    <div class="vs">VS</div>

                    <div class="player">
                        <div class="name">@Game.CurrentMatch.Player2.Nickname</div>
                        <div class="score">@Game.CurrentMatch.Player2Score</div>
                        <div class="meta">
                            Sets: @Game.CurrentMatch.Player2Sets |
                            Legs: @Game.CurrentMatch.Player2Legs
                        </div>
                    </div>

                </div>

            </div>

            <h3>📡 Live Events</h3>

            <div class="timeline">
                @foreach (var ev in Game.Events.OrderByDescending(e => e.Time))
                {
                    <div class="event">

                        <div class="event-header">
                            <b>@ev.Player.Nickname</b>
                            <span class="badge">@ev.Type</span>

                            @if (ev.ScoreChange > 0)
                            {
                                <span class="score">+@ev.ScoreChange</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(ev.Message))
                        {
                            <div class="message">@ev.Message</div>
                        }

                        <div class="time">
                            @ev.Time.ToLongTimeString()
                        </div>

                    </div>
                }
            </div>

        </div>

    </div>
}

@code {

    int selectedPlayerId;
    EventType selectedType = EventType.Score;
    int? score;
    string message = "";

    string? validationMessage;

    protected override void OnInitialized()
    {
        Game.OnChange += async () => await InvokeAsync(StateHasChanged);

        if (Game.CanRenderMatch)
            selectedPlayerId = Game.CurrentMatch.Player1.Id;
    }

    private async Task AddEvent()
    {
        validationMessage = null;

        if (!Game.CanRenderMatch)
        {
            validationMessage = "No active match.";
            return;
        }

       
        if (selectedType != EventType.NoScore)
        {
            if (!score.HasValue)
            {
                validationMessage = "Score is required.";
                return;
            }

            if (score > 180)
            {
                validationMessage = "Score cannot be higher than 180.";
                return;
            }

            if (score < 0)
            {
                validationMessage = "Score cannot be negative.";
                return;
            }
        }

        if (selectedType == EventType.NoScore)
        {
            score = null;
        }

        var finalType = selectedType;

        var player =
            Game.CurrentMatch.Player1.Id == selectedPlayerId
                ? Game.CurrentMatch.Player1
                : Game.CurrentMatch.Player2;

        await Game.AddEvent(new DartEvent
        {
            Player = player,
            Type = finalType,
            ScoreChange = score ?? 0,
            Message = message
        });

        score = null;
        message = "";
    }
}