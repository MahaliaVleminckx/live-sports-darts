@page "/fans"
@inject DartGameService Game
@using Pin.LiveSports.Core.Enums
@using Pin.LiveSports.Blazor.Services
@implements IDisposable

@if (!Game.CanRenderMatch)
{
    <div>No active match</div>
}
else
{
    @if (Game.MatchFinished && Game.Winner != null)
    {
        <div class="winner-banner">
            🏆 Congratulations @Game.Winner.Nickname!
        </div>
    }

    <div class="broadcast-header">
        <div class="title">@Game.CurrentMatch.MatchName</div>
        <div class="meta">
            @Game.CurrentMatch.Tournament • @Game.CurrentMatch.Location
        </div>
        <div class="live-badge">LIVE</div>
    </div>

    <div class="broadcast-score">

        <div class="team">
            <div class="name">@Game.CurrentMatch.Player1?.Nickname</div>
            <div class="score">@Game.CurrentMatch.Player1Score</div>

            <div class="sub">
                Legs: <b>@Game.CurrentMatch.Player1Legs</b>
                • Sets: <b>@Game.CurrentMatch.Player1Sets</b>
            </div>
        </div>

        <div class="vs">VS</div>

        <div class="team">
            <div class="name">@Game.CurrentMatch.Player2?.Nickname</div>
            <div class="score">@Game.CurrentMatch.Player2Score</div>

            <div class="sub">
                Legs: <b>@Game.CurrentMatch.Player2Legs</b>
                • Sets: <b>@Game.CurrentMatch.Player2Sets</b>
            </div>
        </div>

    </div>

    <div class="broadcast-averages">
        <div>
            @Game.CurrentMatch.Player1?.Nickname:
            <b>@Game.GetAverage(Game.CurrentMatch.Player1).ToString("0.00")</b>
        </div>

        <div>
            @Game.CurrentMatch.Player2?.Nickname:
            <b>@Game.GetAverage(Game.CurrentMatch.Player2).ToString("0.00")</b>
        </div>
    </div>

    <div class="broadcast-info">
        Set <b>@Game.CurrentMatch.CurrentSet</b>
        • Leg <b>@Game.CurrentMatch.CurrentLeg</b>
    </div>

    <div class="broadcast-feed">

        @foreach (var ev in Game.Events.OrderByDescending(e => e.Time))
        {
            <div class="feed-item">
                <div class="time">@ev.Time.ToLongTimeString()</div>

                <div class="content">
                    <b>@ev.Player.Nickname</b>
                    <span class="badge">@ev.Type</span>

                    @if (ev.ScoreChange > 0)
                    {
                        <span class="score">-@ev.ScoreChange</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(ev.Message))
                    {
                        <div class="msg">@ev.Message</div>
                    }
                </div>
            </div>
        }

    </div>
}

@code {

    protected override void OnInitialized()
    {
        Game.OnChange += UpdateUI;
    }

    private async Task UpdateUI()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Game.OnChange -= UpdateUI;
    }
}