@page "/"
@inject NavigationManager Nav

<div class="home">

    <div class="hero">

        <div class="logo">🏆 LiveSports</div>

        <div class="subtitle">
            Real-time darts tracking & live match control system
        </div>

        <div class="actions-vertical">

            <button class="btn primary" @onclick="GoSetup">
                ⚙️ Start Setup
            </button>

            <button class="btn secondary" @onclick="GoManagement">
                🧑‍💼 Manage Players
            </button>

            <button class="btn ghost" @onclick="GoReporter">
                🎯 Reporter Mode
            </button>

        </div>

    </div>

</div>

@code {
    void GoSetup() => Nav.NavigateTo("/setup");
    void GoManagement() => Nav.NavigateTo("/sportmanagement");
    void GoReporter() => Nav.NavigateTo("/reporter");
}